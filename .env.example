# Copy this file to .env.local and fill in what you need.
#
# Everything is optional: with no values at all the app serves the built-in
# sample catalogue and the rule reader is off. See README.md for the detail.
#
# Do NOT prefix any of these with NEXT_PUBLIC_. They are server-side values, and
# that prefix would inline them into the browser bundle.

# Neon/Postgres connection string. Absent means static sample data.
DATABASE_URL=""

# Groq key for reading eligibility rules out of the IBASS brochure.
# A free key from https://console.groq.com/keys. Absent turns the reader off.
GROQ_API_KEY=""

# Hard daily ceiling on fresh rule reads across every server instance.
# 0 disables fresh reads without unsetting GROQ_API_KEY.
GROQ_DAILY_CALL_LIMIT="200"

# Swift Agents widget. Both must be set for the widget to appear.
SWIFT_COMPANY_ID=""
SWIFT_API_KEY=""

# Comma-separated keys for the read-only catalogue API at /api/v1.
# Empty means every request gets a 503 rather than an open door.
CATALOGUE_API_KEYS=""

# Public origin, used for absolute links in API payloads.
# APP_BASE_URL="https://admissioncopilot.example"
